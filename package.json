{
  "name": "project-heroine",
  "version": "1.0.0",
  "scripts": {
    "start": "npx serve . -p 3000",
    "tsc": "tsc -p tsconfig.json",
    "tsc:watch": "tsc -p tsconfig.json -w",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:bundle": "esbuild src/main.ts --bundle --outfile=dist/bundle.js --platform=browser --format=iife --target=es2017 --sourcemap",
    "build:bundle:watch": "esbuild src/main.ts --bundle --outfile=dist/bundle.js --platform=browser --format=iife --target=es2017 --sourcemap --watch",
    "build": "npm run build:bundle"
  },
  "devDependencies": {
    "phaser": "^4.0.0",
    "typescript": "^5.5.0",
    "esbuild": "^0.19.0"
  }
}
